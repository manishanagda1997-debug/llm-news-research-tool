# Copy this file, rename the copy to .env and paste your own keys.
# Never upload the .env file.

# Free key from https://newsapi.org/register
NEWSAPI_KEY=your-newsapi-key-here

# Optional: free key from https://aistudio.google.com (Get API key); used only in the Stage 2 model comparison
GOOGLE_API_KEY=your-gemini-key-here

# Optional: Gemini model name (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Gemini limits per model from Google AI Studio, Rate Limit page (free tier: 5 and 250000)
GEMINI_RPM=5
GEMINI_TPM=250000

# Required: free key from https://console.groq.com/keys; the app's summaries and review use Groq
GROQ_API_KEY=your-groq-key-here

# Optional: Groq model and reasoning effort (defaults: openai/gpt-oss-120b, medium)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium

# Optional: Groq limits per model from the console limits page (free plan: 30 and 8000)
GROQ_RPM=30
GROQ_TPM=8000

# The provider of the development scripts: gemini or groq (default: gemini). The app always uses Groq.
LLM_PROVIDER=groq
